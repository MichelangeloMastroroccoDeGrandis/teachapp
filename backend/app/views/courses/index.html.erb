<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-grey-900">Course</h1>
  <% if current_user&.instructor? %>
    <%= link_to "New Course", new_course_path, class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
  <% end %>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
  <% @courses.each do |course| %>
    <div class="rounded-xl border border-grey-200 p-5 hover:shadow-md transition-shadow">
      <h2 class="text-lg font-semibold text-grey-900">
        <%= link_to course.title, course, class: "hover:text-indigo-600" %>
      </h2>
      <p class="mt-2 text-sm text-grey-600"><%= truncate(course.description, lenght: 100)%></p>
      <p class="mt-3 text-sm font-medium text-indigo-600">$<%= course.price %></p>
    </div>
  <% end %>
</div>
