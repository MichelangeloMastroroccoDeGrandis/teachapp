<h1 class="text-2xl font-bold text-grey-900">My Learning</h1>

<% @enrollments.each do |e| %>
    <div class="mt-4 rounded-xl border border-gray-200 p-5">
        <h2 class="text-lg font-semibold"><%= link_to e.course.title e.course, class: "hover:text-indigo-600" %></h2>
        <div class="mt-3 w-full bg-grey-200 rounded-full h-3">
            <div class="bg-indigo-600 h-3 rounded-full" style="width: <%= e.progress_percent % %>"></div>
        </div>
        <p class="mt-1 text-sm text-grey-500"><%= e.progress_percent %>% complete</p>
    </div>
<% end %>
