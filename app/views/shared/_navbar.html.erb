<nav class="bg-white border-b border-gray-200 px-6 py-3 flex items-center justify-between">
  <%= link_to "TeachApp", root_path, class: "text-xl font-bold text-slate-600" %>

  <% if user_signed_in? %>
    <div class="flex items-center gap-4">
      <%= link_to current_user.instructor? ? "Dashboard" : "My Learning", current_user.instructor? ? dashboards_instructor_path : dashboards_student_path, class: "text-sm font-medium text-grey-700 hover:text-indigo-600" %>
      <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "text-sm font-medium text-slate-500 hover:text-red-600 bg-transparent border-0 p-0 cursor-pointer" %>
    </div>
  <% else %>
    <%= link_to "Sign in", new_user_session_path, class: "text-sm font-medium text-slate-600 hover:text-slate-800" %>
  <% end %>
</nav>